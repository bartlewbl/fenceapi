[Unit]
Description=fenceapi HTTP API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fenceapi
Environment=FENCEAPI_INTERVAL=1.0
Environment=FENCEAPI_RATE_LIMIT=100
ExecStart=/opt/fenceapi/.venv/bin/python -m fenceapi serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
