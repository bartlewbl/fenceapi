[Unit]
Description=fenceapi HTTP API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fenceapi
# Host, port, rate limit, scrape interval, and DB paths come from fenceapi.toml
ExecStart=/opt/fenceapi/.venv/bin/python -m fenceapi serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
